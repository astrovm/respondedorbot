# Bot Configuration

# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_USERNAME=your_bot_username
TELEGRAM_LONG_POLL_SECONDS=30
BOT_INSTANCE_NAME=respondedorbot-1

# Infrastructure
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase Postgres session pooler for this persistent process
SUPABASE_POSTGRES_URL=postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# APIs
COINMARKETCAP_KEY=your_coinmarketcap_api_key
# Giphy API key for /gm and /gn GIF commands
GIPHY_API_KEY=your_giphy_api_key
# Optional free-tier Groq key for transcription
GROQ_FREE_API_KEY=your_free_groq_api_key
# Paid Groq key for transcription
GROQ_API_KEY=your_paid_groq_api_key
# OpenRouter key for chat and vision
OPENROUTER_API_KEY=your_openrouter_api_key
# Firecrawl key for direct web search
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Billing reconciliation and maintenance
AI_RECONCILIATION_INTERVAL_SECONDS=60
AI_RECONCILIATION_RETRY_SECONDS=3600
AI_RECONCILIATION_SAFETY_CREDIT_UNITS=10
AI_RECONCILIATION_STALE_SECONDS=300
AI_LEDGER_RETENTION_DAYS=30
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Monitoring
ADMIN_CHAT_ID=your_telegram_chat_id_for_admin_reports
FRIENDLY_INSTANCE_NAME=My_Bot_Instance
