[Unit]
Description=respondedorbot Redis cache
After=network-online.target

[Container]
# Redis 8 includes the Query Engine (RediSearch) and JSON that the bot needs
Image=docker.io/library/redis:8-trixie
ContainerName=respondedorbot-redis
AutoUpdate=registry
Volume=respondedorbot-redis.volume:/data
Network=respondedorbot.network
Exec=redis-server --maxmemory 256mb --maxmemory-policy volatile-lru --appendonly yes --appendfsync always

[Service]
Restart=always
TimeoutStartSec=30

[Install]
WantedBy=default.target
