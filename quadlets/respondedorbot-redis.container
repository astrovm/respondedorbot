[Unit]
Description=respondedorbot Redis cache
After=network-online.target

[Container]
# Redis 8 includes the Query Engine (RediSearch) and JSON that the bot needs
Image=docker.io/library/redis:8-trixie
ContainerName=respondedorbot-redis
AutoUpdate=registry
Volume=respondedorbot-redis.volume:/data
Network=respondedorbot.network
Exec=redis-server --maxmemory 512mb --maxmemory-policy volatile-lru --appendonly yes --appendfsync always
# Healthy only once the dataset is loaded (PING answers LOADING until then), so the bot waits for it
HealthCmd=redis-cli ping | grep -q PONG
HealthInterval=5s
HealthStartPeriod=120s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
