[Unit]
Description=respondedorbot PostgreSQL database
After=network-online.target

[Container]
# Major version and Debian release pinned: a new Debian brings a new ICU, which changes text
# sort order and needs a REINDEX. Minor updates come in through AutoUpdate.
Image=docker.io/library/postgres:18-trixie
ContainerName=respondedorbot-postgres
AutoUpdate=registry
EnvironmentFile=%h/respondedorbot/postgres.env
# ICU sorting, like the Supabase database this replaced.
Environment=POSTGRES_INITDB_ARGS="--locale-provider=icu --icu-locale=en-US"
Volume=respondedorbot-postgres.volume:/var/lib/postgresql
Network=respondedorbot.network
ShmSize=256m
HealthCmd=pg_isready --username=respondedorbot --dbname=respondedorbot
HealthInterval=10s
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=default.target
