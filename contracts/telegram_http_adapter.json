{
  "cases": [
    {
      "name": "successful Bot API payload",
      "status_code": 200,
      "body": "{\"ok\":true,\"result\":{\"message_id\":42}}",
      "expect_json": true,
      "expected_payload": {
        "ok": true,
        "result": {
          "message_id": 42
        }
      },
      "expected_error": null
    },
    {
      "name": "Bot API ok false payload",
      "status_code": 200,
      "body": "{\"ok\":false,\"description\":\"Bad Request: message is not modified\"}",
      "expect_json": true,
      "expected_payload": {
        "ok": false,
        "description": "Bad Request: message is not modified"
      },
      "expected_error": "Bad Request: message is not modified"
    },
    {
      "name": "rate limit HTTP payload",
      "status_code": 429,
      "body": "{\"ok\":false,\"error_code\":429,\"description\":\"Too Many Requests\",\"parameters\":{\"retry_after\":1}}",
      "expect_json": true,
      "expected_payload": {
        "ok": false,
        "error_code": 429,
        "description": "Too Many Requests",
        "parameters": {
          "retry_after": 1
        }
      },
      "expected_error": "Too Many Requests"
    },
    {
      "name": "response body is ignored when JSON is not expected",
      "status_code": 204,
      "body": "not-json",
      "expect_json": false,
      "expected_payload": {},
      "expected_error": null
    },
    {
      "name": "unexpected JSON type",
      "status_code": 200,
      "body": "[]",
      "expect_json": true,
      "expected_payload": null,
      "expected_error": "unexpected response"
    },
    {
      "name": "invalid success JSON",
      "status_code": 200,
      "body": "not-json",
      "expect_json": true,
      "expected_payload": null,
      "expected_error": "Expecting value: line 1 column 1 (char 0)"
    },
    {
      "name": "non-JSON upstream error",
      "status_code": 502,
      "body": "gateway failure",
      "expect_json": true,
      "expected_payload": null,
      "expected_error": "Telegram HTTP 502"
    }
  ],
  "transport_errors": [
    {
      "kind": "timeout",
      "expected_error": "Telegram request timed out"
    },
    {
      "kind": "connection",
      "expected_error": "Telegram connection failed"
    },
    {
      "kind": "request",
      "expected_error": "Telegram request failed"
    },
    {
      "kind": "response_too_large",
      "expected_error": "Telegram response too large"
    }
  ]
}
