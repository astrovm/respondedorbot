{
  "cases": [
    {
      "name": "resolved provider identity records every response detail",
      "input": [
        "requested/model",
        "resolved/model",
        "SyntheticProvider",
        "priority",
        "openrouter"
      ],
      "expected": [
        "resolved/model",
        "requested/model",
        "SyntheticProvider",
        "priority",
        "openrouter"
      ]
    },
    {
      "name": "matching model does not duplicate requested model metadata",
      "input": ["same/model", "same/model", null, null, "groq"],
      "expected": ["same/model", null, null, null, "groq"]
    },
    {
      "name": "missing response identity uses request and unknown source",
      "input": ["requested/model", null, null, null, null],
      "expected": ["requested/model", null, null, null, "unknown"]
    }
  ]
}
