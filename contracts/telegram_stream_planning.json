{
  "should_edit_cases": [
    {
      "name": "thresholds met exactly",
      "facts": [false, true, 2.0, 1.0, 20, 5, 1.0, 15],
      "expected": true
    },
    {
      "name": "finalized stream never edits",
      "facts": [true, true, 2.0, 1.0, 20, 5, 1.0, 15],
      "expected": false
    },
    {
      "name": "message must already exist",
      "facts": [false, false, 2.0, 1.0, 20, 5, 1.0, 15],
      "expected": false
    },
    {
      "name": "minimum interval not reached",
      "facts": [false, true, 1.9, 1.0, 20, 5, 1.0, 15],
      "expected": false
    },
    {
      "name": "minimum new characters not reached",
      "facts": [false, true, 2.0, 1.0, 19, 5, 1.0, 15],
      "expected": false
    }
  ],
  "feed_cases": [
    {
      "name": "first token sends initial message",
      "facts": [false, false, false, "", "", "hi", 0.0, 0.0, 0.3, 15],
      "expected": ["hi", "send"]
    },
    {
      "name": "short interval only buffers",
      "facts": [false, true, true, "hello", "hello", " there", 1.1, 1.0, 0.3, 5],
      "expected": ["hello there", "none"]
    },
    {
      "name": "elapsed interval and characters edit",
      "facts": [false, true, true, "hello", "hello", " there", 1.3, 1.0, 0.3, 5],
      "expected": ["hello there", "edit"]
    },
    {
      "name": "failed initial send is not repeated by feed",
      "facts": [false, false, true, "hello", "hello", " there", 2.0, 1.0, 0.3, 5],
      "expected": ["hello there", "none"]
    },
    {
      "name": "finalized stream ignores later tokens",
      "facts": [true, false, false, "done", "", " ignored", 0.0, 0.0, 0.0, 0],
      "expected": ["done", "none"]
    },
    {
      "name": "unicode thresholds count characters",
      "facts": [false, true, true, "😀á", "😀", "ñ", 2.0, 1.0, 1.0, 2],
      "expected": ["😀áñ", "edit"]
    }
  ],
  "finalize_cases": [
    {
      "name": "unsent buffer sends",
      "facts": ["buffer", "", false, null],
      "expected": ["buffer", "send"]
    },
    {
      "name": "explicit final text edits",
      "facts": ["buffer", "old", true, "final"],
      "expected": ["final", "edit"]
    },
    {
      "name": "unchanged buffer is a no-op",
      "facts": ["same", "same", true, null],
      "expected": ["same", "none"]
    },
    {
      "name": "empty explicit final text is preserved",
      "facts": ["buffer", "old", true, ""],
      "expected": ["", "edit"]
    }
  ]
}
