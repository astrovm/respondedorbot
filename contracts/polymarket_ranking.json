{
  "cases": [
    {
      "name": "live prices override cached ranking",
      "input": [
        { "title": "Cached leader", "cached_probability": 0.9, "live_probability": 0.2 },
        { "title": "Live leader", "cached_probability": 0.4, "live_probability": 0.8 },
        { "title": "Cached only", "cached_probability": 0.6, "live_probability": null }
      ],
      "limit": 2,
      "expected": [
        { "title": "Live leader", "percentage": 80.0 },
        { "title": "Cached only", "percentage": 60.0 }
      ]
    },
    {
      "name": "clamping and stable ties",
      "input": [
        { "title": "First", "cached_probability": 2.0, "live_probability": null },
        { "title": "Second", "cached_probability": 0.1, "live_probability": 3.0 },
        { "title": "Last", "cached_probability": -1.0, "live_probability": null }
      ],
      "limit": 10,
      "expected": [
        { "title": "First", "percentage": 100.0 },
        { "title": "Second", "percentage": 100.0 },
        { "title": "Last", "percentage": 0.0 }
      ]
    },
    {
      "name": "zero limit",
      "input": [
        { "title": "Ignored", "cached_probability": 0.5, "live_probability": null }
      ],
      "limit": 0,
      "expected": []
    }
  ]
}
