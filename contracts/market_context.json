{
  "cases": [
    {
      "name": "empty snapshot",
      "input": {},
      "expected": ""
    },
    {
      "name": "nested provider snapshot",
      "input": {
        "crypto": [
          {
            "symbol": "BTC",
            "quote": {
              "USD": {
                "price": 50000,
                "changes": { "24h": 2.5 },
                "dominance": 52.25
              }
            }
          }
        ],
        "dollar": {
          "oficial": { "price": 1000 },
          "blue": { "ask": 1200, "bid": 1180 },
          "mep": { "al30": { "ci": { "price": 1150 } } },
          "tarjeta": { "price": 1600 },
          "cripto": { "usdt": { "ask": 1230, "bid": 1220 } }
        }
      },
      "expected": "PRECIOS DE CRIPTOS:\n- BTC: 50000 usd (+2.5 24h), dom 52.2%\nDOLARES:\n- oficial: 1000\n- blue: 1200 (bid 1180)\n- mep al30 ci: 1150\n- tarjeta: 1600\n- usdt: 1230 (bid 1220)"
    },
    {
      "name": "flat legacy snapshot",
      "input": {
        "crypto": [
          { "name": "Bitcoin", "price": 45000.5, "change_24h": -1.25 },
          { "name": "Ethereum", "price": "3000.25" }
        ],
        "dollar": [
          { "name": "Oficial", "price": 1000.5 },
          { "label": "Blue", "price": "1200" }
        ]
      },
      "expected": "PRECIOS DE CRIPTOS:\n- BITCOIN: 45000.5 usd (-1.25 24h)\n- ETHEREUM: 3000.25 usd\nDOLARES:\n- oficial: 1000.5\n- blue: 1200"
    },
    {
      "name": "only first three crypto rows are considered",
      "input": {
        "crypto": [
          { "symbol": "ONE", "price": 1 },
          { "symbol": "", "price": 2 },
          { "symbol": "THREE", "price": 3 },
          { "symbol": "FOUR", "price": 4 }
        ]
      },
      "expected": "PRECIOS DE CRIPTOS:\n- ONE: 1 usd\n- THREE: 3 usd"
    },
    {
      "name": "empty usd quote falls back to flat fields",
      "input": {
        "crypto": [
          {
            "symbol": "SOL",
            "price": "125.50",
            "change_24h": "0.75",
            "quote": { "USD": {} }
          }
        ]
      },
      "expected": "PRECIOS DE CRIPTOS:\n- SOL: 125.5 usd (+0.75 24h)"
    },
    {
      "name": "invalid records are omitted",
      "input": {
        "crypto": [
          null,
          { "symbol": "BTC", "price": "bad" },
          { "symbol": "ETH", "price": 2 }
        ],
        "dollar": [
          null,
          { "name": "", "price": 1 },
          { "name": "Blue", "price": "bad" },
          { "name": "Oficial", "price": true }
        ]
      },
      "expected": "PRECIOS DE CRIPTOS:\n- ETH: 2 usd\nDOLARES:\n- oficial: 1"
    },
    {
      "name": "blue falls back from ask to price",
      "input": {
        "dollar": {
          "blue": { "ask": null, "price": 1201.25, "bid": "1199.5" }
        }
      },
      "expected": "DOLARES:\n- blue: 1201.25 (bid 1199.5)"
    },
    {
      "name": "non-sequence sections are ignored",
      "input": {
        "crypto": "not rows",
        "dollar": 42
      },
      "expected": ""
    }
  ]
}
