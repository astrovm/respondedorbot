{
  "utf16": [
    { "name": "after emoji", "text": "a😀 link", "offset": 3, "length": 5, "expected": " link" },
    { "name": "half surrogate is ignored", "text": "a😀 link", "offset": 1, "length": 1, "expected": "" },
    { "name": "negative offset clamps", "text": "abc", "offset": -2, "length": 1, "expected": "a" }
  ],
  "trim": [
    { "name": "punctuation and whitespace", "input": "  https://example.test/path).  ", "expected": "https://example.test/path" },
    { "name": "opening parenthesis remains", "input": "https://example.test/path(", "expected": "https://example.test/path(" }
  ],
  "unique": [
    {
      "name": "stable deduplication",
      "candidates": ["https://a.test", "https://a.test", "https://b.test", "https://c.test"],
      "max_links": 2,
      "expected": ["https://a.test", "https://b.test"]
    },
    {
      "name": "legacy zero limit",
      "candidates": ["https://a.test", "https://b.test"],
      "max_links": 0,
      "expected": ["https://a.test"]
    }
  ]
}
