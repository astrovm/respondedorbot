{
  "content_cases": [
    {
      "name": "text caption poll and direct media",
      "message": {
        "text": "  hola  ",
        "caption": " mundo ",
        "poll": {
          "question": " Elegí ",
          "options": [
            {"text": " Uno "},
            {"text": "Dos"}
          ]
        },
        "photo": [
          {"file_id": "small"},
          {"file_id": "large"}
        ],
        "audio": {"file_id": "audio"},
        "video": {"file_id": "video"}
      },
      "expected": {
        "text": "hola\n\nmundo\n\nElegí\nOpciones:\n- Uno\n- Dos",
        "photo_file_id": "large",
        "audio_file_id": "audio"
      }
    },
    {
      "name": "animated sticker and replied video",
      "message": {
        "sticker": {
          "is_animated": true,
          "file_id": "animated",
          "thumbnail": {"file_id": "thumb"}
        },
        "reply_to_message": {
          "video": {"file_id": "replied-video"}
        }
      },
      "expected": {
        "text": "",
        "photo_file_id": "thumb",
        "audio_file_id": "replied-video"
      }
    },
    {
      "name": "empty poll question keeps options",
      "message": {
        "poll": {
          "question": "",
          "options": [
            {"text": "Sí"},
            {"ignored": true}
          ]
        }
      },
      "expected": {
        "text": "Opciones:\n- Sí",
        "photo_file_id": null,
        "audio_file_id": null
      }
    }
  ],
  "numeric_id_cases": [
    {"value": " -100123 ", "expected": -100123},
    {"value": 12.9, "expected": 12},
    {"value": true, "expected": 1},
    {"value": "invalid", "expected": null}
  ],
  "user_cases": [
