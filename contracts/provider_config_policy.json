{
  "credential_cases": [
    {
      "name": "free account selects and trims free key",
      "account": "free",
      "free_api_key": "  free-key  ",
      "paid_api_key": "paid-key",
      "expected": "free-key"
    },
    {
      "name": "paid account selects paid key",
      "account": "paid",
      "free_api_key": "free-key",
      "paid_api_key": " paid-key ",
      "expected": "paid-key"
    },
    {
      "name": "legacy unknown account also selects paid key",
      "account": "other",
      "free_api_key": "free-key",
      "paid_api_key": "other-key",
      "expected": "other-key"
    },
    {
      "name": "blank selected key is unavailable",
      "account": "free",
      "free_api_key": "  ",
      "paid_api_key": "paid-key",
      "expected": null
    }
  ],
  "openrouter_key_cases": [
    {
      "name": "OpenRouter key is trimmed",
      "value": " router-key ",
      "expected": "router-key"
    },
    {
      "name": "missing OpenRouter key stays missing",
      "value": null,
      "expected": null
    }
  ],
  "account_cases": [
    {
      "name": "configured accounts preserve configured order",
      "account_order": ["free", "paid", "backup"],
      "configured": [true, false, true],
      "expected": ["free", "backup"]
    },
    {
      "name": "no configured accounts remains empty",
      "account_order": ["free", "paid"],
      "configured": [false, false],
      "expected": []
    }
  ],
  "backoff_cases": [
    {
      "name": "Groq backoff key is normalized",
      "account": "FREE",
      "scope": "CHAT",
      "expected": "groq:free:chat"
    },
    {
      "name": "scope text is preserved apart from case",
      "account": "paid",
      "scope": "Audio Transcription",
      "expected": "groq:paid:audio transcription"
    }
  ],
  "scope_cases": [
    {
      "name": "OpenRouter fallback leaves empty account set available",
      "backoff_active": [],
      "expected": true
    },
    {
      "name": "one active account keeps scope available",
      "backoff_active": [true, false],
      "expected": true
    },
    {
      "name": "all cooled-down accounts block scope",
      "backoff_active": [true, true],
      "expected": false
    }
  ],
  "web_search_cases": [
    {
      "name": "positive Firecrawl limits",
      "max_results": 5,
      "max_queries": 3,
      "expected": {
        "type": "openrouter:web_search",
        "parameters": {
          "engine": "firecrawl",
          "max_results": 5,
          "max_uses": 3,
          "max_total_results": 15
        }
      }
    },
    {
      "name": "zero and negative values retain legacy arithmetic",
      "max_results": -2,
      "max_queries": 0,
      "expected": {
        "type": "openrouter:web_search",
        "parameters": {
          "engine": "firecrawl",
          "max_results": -2,
          "max_uses": 0,
          "max_total_results": 0
        }
      }
    }
  ],
  "openrouter_base_url": "https://openrouter.ai/api/v1"
}
