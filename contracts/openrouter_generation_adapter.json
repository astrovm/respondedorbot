{
  "cases": [
    {
      "name": "nested generation envelope",
      "status_code": 200,
      "body": "{\"data\":{\"id\":\"generation-1\",\"upstream_inference_cost\":0.0002},\"ignored\":true}",
      "expected": {
        "status": "success",
        "generation": {
          "id": "generation-1",
          "upstream_inference_cost": 0.0002
        }
      }
    },
    {
      "name": "flat generation payload",
      "status_code": 302,
      "body": "{\"id\":\"generation-2\",\"tokens_prompt\":100}",
      "expected": {
        "status": "success",
        "generation": {
          "id": "generation-2",
          "tokens_prompt": 100
        }
      }
    },
    {
      "name": "missing generation",
      "status_code": 404,
      "body": "not-json",
      "expected": {
        "status": "pending"
      }
    },
    {
      "name": "non-object payload",
      "status_code": 200,
      "body": "[]",
      "expected": {
        "status": "pending"
      }
    }
  ],
  "errors": [
    {
      "name": "upstream failure",
      "status_code": 503,
      "body": "{\"error\":\"unavailable\"}",
      "error": "OpenRouter generation HTTP 503"
    },
    {
      "name": "invalid JSON",
      "status_code": 200,
      "body": "not-json",
      "error_prefix": "OpenRouter generation returned invalid JSON:"
    }
  ]
}
