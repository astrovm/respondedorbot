{
  "cases": [
    {
      "name": "missing trigger",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "missing" }
      },
      "expected": { "trigger": null, "error": { "code": "required" } }
    },
    {
      "name": "delay takes priority",
      "input": {
        "delay_seconds": { "state": "value", "value": 15 },
        "interval_seconds": { "state": "value", "value": 600 },
        "config": { "kind": "unsupported" }
      },
      "expected": { "trigger": { "kind": "delay", "seconds": 15 }, "error": null }
    },
    {
      "name": "invalid delay",
      "input": {
        "delay_seconds": { "state": "invalid" },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "missing" }
      },
      "expected": { "trigger": null, "error": { "code": "delay_positive" } }
    },
    {
      "name": "delay above maximum",
      "input": {
        "delay_seconds": { "state": "value", "value": 315360001 },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "missing" }
      },
      "expected": { "trigger": null, "error": { "code": "delay_max" } }
    },
    {
      "name": "valid second interval",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "value", "value": 3600 },
        "config": { "kind": "missing" }
      },
      "expected": {
        "trigger": { "kind": "interval_seconds", "seconds": 3600 },
        "error": null
      }
    },
    {
      "name": "second interval too short",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "value", "value": 299 },
        "config": { "kind": "missing" }
      },
      "expected": { "trigger": null, "error": { "code": "interval_min" } }
    },
    {
      "name": "second interval too long",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "value", "value": 604801 },
        "config": { "kind": "missing" }
      },
      "expected": { "trigger": null, "error": { "code": "interval_max" } }
    },
    {
      "name": "unsupported config type",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "unsupported" }
      },
      "expected": { "trigger": null, "error": { "code": "type" } }
    },
    {
      "name": "valid day interval",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "interval_days", "days": { "state": "value", "value": 3 } }
      },
      "expected": { "trigger": { "kind": "interval_days", "days": 3 }, "error": null }
    },
    {
      "name": "missing interval days",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "interval_days", "days": { "state": "missing" } }
      },
      "expected": { "trigger": null, "error": { "code": "days_required" } }
    },
    {
      "name": "invalid interval days",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "interval_days", "days": { "state": "value", "value": 0 } }
      },
      "expected": { "trigger": null, "error": { "code": "days_positive" } }
    },
    {
      "name": "interval days too large",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": { "kind": "interval_days", "days": { "state": "value", "value": 91 } }
      },
      "expected": { "trigger": null, "error": { "code": "days_max" } }
    },
    {
      "name": "daily cron",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 4 },
          "minute": { "state": "value", "value": 20 },
          "weekdays": null,
          "day": { "state": "missing" }
        }
      },
      "expected": {
        "trigger": { "kind": "cron", "hour": 4, "minute": 20, "weekdays": [], "day": null },
        "error": null
      }
    },
    {
      "name": "localized weekday cron",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 9 },
          "minute": { "state": "value", "value": 0 },
          "weekdays": "lun, MIE",
          "day": { "state": "missing" }
        }
      },
      "expected": {
        "trigger": { "kind": "cron", "hour": 9, "minute": 0, "weekdays": ["mon", "wed"], "day": null },
        "error": null
      }
    },
    {
      "name": "monthly cron",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 7 },
          "minute": { "state": "value", "value": 30 },
          "weekdays": "",
          "day": { "state": "value", "value": 12 }
        }
      },
      "expected": {
        "trigger": { "kind": "cron", "hour": 7, "minute": 30, "weekdays": [], "day": 12 },
        "error": null
      }
    },
    {
      "name": "missing cron hour",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "missing" },
          "minute": { "state": "value", "value": 0 },
          "weekdays": null,
          "day": { "state": "missing" }
        }
      },
      "expected": { "trigger": null, "error": { "code": "hour_required" } }
    },
    {
      "name": "invalid cron hour",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 24 },
          "minute": { "state": "value", "value": 0 },
          "weekdays": null,
          "day": { "state": "missing" }
        }
      },
      "expected": { "trigger": null, "error": { "code": "hour_range" } }
    },
    {
      "name": "missing cron minute",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 0 },
          "minute": { "state": "missing" },
          "weekdays": null,
          "day": { "state": "missing" }
        }
      },
      "expected": { "trigger": null, "error": { "code": "minute_required" } }
    },
    {
      "name": "invalid cron minute",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 0 },
          "minute": { "state": "value", "value": 60 },
          "weekdays": null,
          "day": { "state": "missing" }
        }
      },
      "expected": { "trigger": null, "error": { "code": "minute_range" } }
    },
    {
      "name": "invalid weekday",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 0 },
          "minute": { "state": "value", "value": 0 },
          "weekdays": "foo",
          "day": { "state": "missing" }
        }
      },
      "expected": { "trigger": null, "error": { "code": "weekday", "value": "foo" } }
    },
    {
      "name": "empty weekday list",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 0 },
          "minute": { "state": "value", "value": 0 },
          "weekdays": " , ",
          "day": { "state": "missing" }
        }
      },
      "expected": { "trigger": null, "error": { "code": "weekday_empty" } }
    },
    {
      "name": "invalid day of month",
      "input": {
        "delay_seconds": { "state": "missing" },
        "interval_seconds": { "state": "missing" },
        "config": {
          "kind": "cron",
          "hour": { "state": "value", "value": 0 },
          "minute": { "state": "value", "value": 0 },
          "weekdays": null,
          "day": { "state": "value", "value": 32 }
        }
      },
      "expected": { "trigger": null, "error": { "code": "day_range" } }
    }
  ]
}
