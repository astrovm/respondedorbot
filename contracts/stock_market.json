{
  "quote_cases": [
    {
      "name": "Yahoo metadata quote",
      "fallback_symbol": "FALLBACK",
      "response": {
        "data": {
          "chart": {
            "result": [
              {
                "meta": {
                  "symbol": "exm.ba",
                  "shortName": "Example Holdings",
                  "regularMarketPrice": 123.45,
                  "chartPreviousClose": 120,
                  "currency": "ars",
                  "exchangeName": "Synthetic Exchange"
                },
                "indicators": {
                  "quote": [
                    {
                      "close": [118, 120, 123.45]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "expected": {
        "symbol": "EXM.BA",
        "name": "Example Holdings",
        "price": 123.45,
        "currency": "ARS",
        "exchange": "Synthetic Exchange",
        "variation": 2.875000000000002
      }
    },
    {
      "name": "closing-price and field defaults",
      "fallback_symbol": "alt",
      "response": {
        "data": {
          "chart": {
            "result": [
              {
                "meta": {},
                "indicators": {
                  "quote": [
                    {
                      "close": [null, 10, 12]
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "expected": {
        "symbol": "ALT",
        "name": "",
        "price": 12.0,
        "currency": "USD",
        "exchange": "",
        "variation": 20.0
      }
    },
    {
      "name": "missing result",
      "fallback_symbol": "EXM",
      "response": {},
      "expected": null
    }
  ],
  "symbol_cases": [
    {
      "name": "unsupported quote types are skipped",
      "response": {
        "data": {
          "quotes": [
            {
              "quoteType": "CRYPTOCURRENCY",
              "symbol": "BTC-USD"
            },
            {
              "quoteType": "EQUITY",
              "symbol": "EXM"
            }
          ]
        }
      },
      "expected": "EXM"
    },
    {
      "name": "missing quotes",
      "response": {},
      "expected": null
    }
  ],
  "query_cases": [
    {
      "name": "comma-separated symbols and names",
      "message": "  $exm.ba, Example Holdings ,, ",
      "expected": {
        "raw_query": "$exm.ba, Example Holdings ,,",
        "queries": [
          {
            "original": "$exm.ba",
            "normalized": "EXM.BA",
            "is_symbol": true
          },
          {
            "original": "Example Holdings",
            "normalized": "EXAMPLE HOLDINGS",
            "is_symbol": false
          }
        ],
        "full_query_fallback": false,
        "needs_top_stocks": false
      }
    },
    {
      "name": "empty query requests top stocks",
      "message": "  ",
      "expected": {
        "raw_query": "",
        "queries": [],
        "full_query_fallback": false,
        "needs_top_stocks": true
      }
    }
  ],
  "finviz_cases": [
    {
      "name": "company duplicates are removed",
      "html": "<a data-boxover-ticker=\"EXM\" data-boxover-company=\"Example\"><a data-boxover-ticker=\"ALT\" data-boxover-company=\"Example\"><a data-boxover-ticker=\"OTH\" data-boxover-company=\"Other\">",
      "expected": ["EXM", "OTH"]
    },
    {
      "name": "unrelated HTML is empty",
      "html": "<html><body>synthetic</body></html>",
      "expected": []
    }
  ]
}
