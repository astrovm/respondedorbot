{
  "argument_cases": [
    {
      "name": "object arguments",
      "raw": "{\"query\":\"rust\",\"limit\":3}",
      "expected": {"query": "rust", "limit": 3},
      "rust_valid": true
    },
    {
      "name": "nested unicode arguments",
      "raw": "{\"location\":\"Córdoba\",\"options\":{\"units\":\"metric\"},\"days\":[1,2]}",
      "expected": {
        "location": "Córdoba",
        "options": {"units": "metric"},
        "days": [1, 2]
      },
      "rust_valid": true
    },
    {
      "name": "arbitrary precision integer is preserved",
      "raw": "{\"value\":123456789012345678901234567890}",
      "expected": {"value": 123456789012345678901234567890},
      "rust_valid": true
    },
    {
      "name": "array is not an argument object",
      "raw": "[1,2,3]",
      "expected": {},
      "rust_valid": true
    },
    {
      "name": "null is not an argument object",
      "raw": "null",
      "expected": {},
      "rust_valid": true
    },
    {
      "name": "malformed JSON uses adapter fallback",
      "raw": "not JSON",
      "expected": {},
      "rust_valid": false
    },
    {
      "name": "Python non-finite JSON uses adapter fallback",
      "raw": "{\"value\":NaN}",
      "expected_non_finite_key": "value",
      "rust_valid": false
    }
  ],
  "availability_cases": [
    {
      "name": "unfiltered catalog preserves every registration",
      "context_provided": false,
      "task_mode": false,
      "tools": [
        {
          "environment_requirements_met": true,
          "context_requirements_met": false,
          "task_allowed": true
        },
        {
          "environment_requirements_met": false,
          "context_requirements_met": true,
          "task_allowed": false
        }
      ],
      "expected": [0, 1]
    },
    {
      "name": "conversation catalog requires environment and context",
      "context_provided": true,
      "task_mode": false,
      "tools": [
        {
          "environment_requirements_met": true,
          "context_requirements_met": true,
          "task_allowed": false
        },
        {
          "environment_requirements_met": false,
          "context_requirements_met": true,
          "task_allowed": true
        },
        {
          "environment_requirements_met": true,
          "context_requirements_met": false,
          "task_allowed": true
        }
      ],
      "expected": [0]
    },
    {
      "name": "task catalog without context ignores context requirements",
      "context_provided": false,
      "task_mode": true,
      "tools": [
        {
          "environment_requirements_met": true,
          "context_requirements_met": false,
          "task_allowed": true
        },
        {
          "environment_requirements_met": false,
          "context_requirements_met": true,
          "task_allowed": true
        },
        {
          "environment_requirements_met": true,
          "context_requirements_met": true,
          "task_allowed": false
        }
      ],
      "expected": [0]
    },
    {
      "name": "task catalog with context applies all filters",
      "context_provided": true,
      "task_mode": true,
      "tools": [
        {
          "environment_requirements_met": true,
          "context_requirements_met": true,
          "task_allowed": true
        },
        {
          "environment_requirements_met": true,
          "context_requirements_met": true,
          "task_allowed": false
        }
      ],
      "expected": [0]
    },
    {
      "name": "empty catalog",
      "context_provided": true,
      "task_mode": true,
      "tools": [],
      "expected": []
    }
  ]
}
