{
  "cases": [
    {
      "name": "nested web results are cleaned and missing URLs are skipped",
      "status_code": 200,
      "query": "Persona Ejemplo",
      "body": "{\"success\":true,\"id\":\"search-1\",\"creditsUsed\":2,\"data\":{\"web\":[{\"title\":\"  Persona\\nEjemplo \",\"url\":\"https://example.com/profile\",\"description\":\" Perfil público. \"},{\"title\":\"sin URL\"}]}}",
      "expected": {
        "status": "success",
        "query": "Persona Ejemplo",
        "results": [
          {
            "title": "Persona Ejemplo",
            "url": "https://example.com/profile",
            "description": "Perfil público."
          }
        ],
        "credits_used": 2,
        "request_id": "search-1"
      }
    },
    {
      "name": "flat result arrays remain compatible",
      "status_code": 302,
      "query": "redirected",
      "body": "{\"success\":true,\"data\":[{\"url\":\"https://example.com\",\"title\":null,\"description\":false}]}",
      "expected": {
        "status": "success",
        "query": "redirected",
        "results": [
          {
            "title": "",
            "url": "https://example.com",
            "description": ""
          }
        ],
        "credits_used": null,
        "request_id": null
      }
    },
    {
      "name": "HTTP errors prefer the API error field",
      "status_code": 429,
      "query": "limited",
      "body": "{\"success\":false,\"error\":\"  retry later  \"}",
      "expected": {
        "status": "http_error",
        "status_code": 429,
        "detail": "retry later"
      }
    },
    {
      "name": "non-JSON HTTP errors preserve bounded text",
      "status_code": 500,
      "query": "broken",
      "body": " upstream   unavailable ",
      "expected": {
        "status": "http_error",
        "status_code": 500,
        "detail": "upstream unavailable"
      }
    },
    {
      "name": "invalid success JSON is typed",
      "status_code": 200,
      "query": "invalid",
      "body": "not-json",
      "expected": {
        "status": "invalid_json"
      }
    },
    {
      "name": "unsuccessful API responses use message detail",
      "status_code": 200,
      "query": "failed",
      "body": "{\"success\":false,\"message\":\"request rejected\"}",
      "expected": {
        "status": "api_error",
        "detail": "request rejected"
      }
    }
  ]
}
