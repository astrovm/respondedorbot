{
  "version": 1,
  "scenarios": [
    {
      "name": "complete_config_callback",
      "input": {
        "id": "callback-1",
        "data": "cfg:language:en",
        "message": {
          "message_id": "7",
          "chat": {"id": -10042, "type": "supergroup"}
        },
        "from": {"id": "99", "language_code": "es"}
      },
      "expected": {
        "kind": "context",
        "context": {
          "callback_id": "callback-1",
          "data": "cfg:language:en",
          "chat_id": "-10042",
          "chat_type": "supergroup",
          "message_id": 7,
          "user_id": 99,
          "user_language_code": "es",
          "route": "config"
        }
      }
    },
    {
      "name": "missing_data_is_guarded",
      "input": {"id": "callback-2", "message": {"message_id": 8, "chat": {"id": 1}}},
      "expected": {"kind": "guard"}
    },
    {
      "name": "unknown_route_remains_dispatchable",
      "input": {
        "data": "future:value",
        "message": {"message_id": 9, "chat": {"id": 2, "type": "private"}},
        "from": {}
      },
      "expected": {
        "kind": "context",
        "context": {
          "callback_id": null,
          "data": "future:value",
          "chat_id": "2",
          "chat_type": "private",
          "message_id": 9,
          "user_id": null,
          "user_language_code": null,
          "route": "unknown"
        }
      }
    }
  ]
}
