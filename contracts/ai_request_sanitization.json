{
  "text_cases": [
    {
      "name": "lowercase and trailing periods",
      "input": "HOLA...",
      "expected": "hola"
    },
    {
      "name": "emoji and supplementary symbols are removed",
      "input": "Respuesta 😀 🀀 OK.",
      "expected": "respuesta   ok"
    },
    {
      "name": "characters above the legacy range remain",
      "input": "TEST 𠀀.",
      "expected": "test 𠀀"
    },
    {
      "name": "trailing whitespace protects an earlier period",
      "input": "Keep.   ",
      "expected": "keep.   "
    },
    {
      "name": "unicode lowercase expansion",
      "input": "İSTANBUL.",
      "expected": "i̇stanbul"
    },
    {
      "name": "contextual Greek lowercase",
      "input": "ΟΣ.",
      "expected": "ος"
    },
    {
      "name": "empty text",
      "input": "",
      "expected": ""
    }
  ]
}
